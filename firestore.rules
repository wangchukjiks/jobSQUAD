rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'wangchukjiks@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phone', 'accountType', 'acceptedTerms', 'acceptedTermsAt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'accountType', 'acceptedTerms', 'acceptedTermsAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40 &&
        data.accountType in ['seeker', 'employer', 'lister'] &&
        data.acceptedTerms == true &&
        data.acceptedTermsAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function hasValidImages(data) {
      return data.images is list &&
        data.images.size() <= 3 &&
        (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() <= 450000)) &&
        (data.images.size() < 2 || (data.images[1] is string && data.images[1].size() <= 450000)) &&
        (data.images.size() < 3 || (data.images[2] is string && data.images[2].size() <= 450000));
    }

    function isValidListing(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerName', 'type', 'category', 'title', 'description',
          'location', 'priceEur', 'contactEmail', 'contactPhone', 'images',
          'specs', 'translations', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'ownerName', 'type', 'category', 'title', 'description',
          'location', 'priceEur', 'contactEmail', 'contactPhone', 'images',
          'specs', 'translations', 'status', 'flagged', 'flagReason',
          'flaggedAt', 'flaggedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 120 &&
        data.type in ['job', 'house', 'car', 'sale'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 3000 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 160 &&
        data.priceEur is number && data.priceEur >= 0 && data.priceEur <= 100000000 &&
        data.contactEmail is string && data.contactEmail.size() >= 5 && data.contactEmail.size() <= 160 &&
        data.contactPhone is string && data.contactPhone.size() <= 40 &&
        (data.type == 'job' || data.contactPhone.size() >= 6) &&
        hasValidImages(data) &&
        (data.type == 'job' || data.images.size() >= 1) &&
        data.specs is map &&
        data.translations is map &&
        data.status in ['active', 'closed'] &&
        (!('flagged' in data) || data.flagged is bool) &&
        (!('flagReason' in data) || (data.flagReason is string && data.flagReason.size() <= 500)) &&
        (!('flaggedAt' in data) || data.flaggedAt is timestamp || data.flaggedAt == null) &&
        (!('flaggedBy' in data) || (data.flaggedBy is string && data.flaggedBy.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Health check document for client SDK startup validation
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Strict PII-isolated user profile documents
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().acceptedTerms == true &&
        incoming().acceptedTermsAt == request.time &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            (
              (
                'acceptedTerms' in existing() &&
                incoming().acceptedTerms == existing().acceptedTerms &&
                incoming().acceptedTermsAt == existing().acceptedTermsAt &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'accountType', 'updatedAt'])
              ) ||
              (
                !('acceptedTerms' in existing()) &&
                incoming().acceptedTerms == true &&
                incoming().acceptedTermsAt == request.time &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'accountType', 'acceptedTerms', 'acceptedTermsAt', 'updatedAt'])
              )
            )
          ) ||
          (
            isAdmin() &&
            (
              (
                'acceptedTerms' in existing() &&
                incoming().acceptedTerms == existing().acceptedTerms &&
                incoming().acceptedTermsAt == existing().acceptedTermsAt &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'accountType', 'updatedAt'])
              ) ||
              (
                !('acceptedTerms' in existing()) &&
                incoming().acceptedTerms == true &&
                incoming().acceptedTermsAt == request.time &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'accountType', 'acceptedTerms', 'acceptedTermsAt', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Trusted Admin Registry (read-only from client)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    // Marketplace Listings (Publicly browsable, strictly validated writes)
    match /listings/{listingId} {
      allow get: if isValidId(listingId);
      allow list: if true;
      allow create: if isVerifiedUser() &&
        isValidId(listingId) &&
        isValidListing(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        (!('flagged' in incoming()) || incoming().flagged == false) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(listingId) &&
        isValidListing(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(existing().ownerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'title', 'description', 'location', 'priceEur',
              'contactEmail', 'contactPhone', 'images', 'specs', 'translations',
              'status', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName', 'category', 'title', 'description', 'location', 'priceEur',
              'contactEmail', 'contactPhone', 'images', 'specs', 'translations',
              'status', 'flagged', 'flagReason', 'flaggedAt', 'flaggedBy', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(listingId) && (isOwner(existing().ownerId) || isAdmin());
    }
  }
}
